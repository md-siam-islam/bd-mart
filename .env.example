# ====================================================================
# BD Mart Bangladesh E-Commerce - Environment Configuration Template
# ====================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your project root:
#      copy .env.example .env
# 2. Update the administrator credentials below with your own secure values.
# 3. In Vite, environment variables accessible on the client must be prefixed
#    with 'VITE_'.
#
# SECURITY NOTICE:
# - Never commit your real '.env' file with production credentials to Git.
# - BD Mart uses client-side salted SHA-256 password hashing. Passwords are
#   never stored in plaintext in local databases or browser storage.
# - To change an admin password after setup, log into the Admin Portal
#   (/admin/login) and navigate to "Store Settings" -> "Admin Profile".
# - To create additional administrators, go to "Store Settings" -> "Team Management".

# Initial Super Admin Email
VITE_ADMIN_EMAIL=mdsiamislam663@gmail.com

# Initial Super Admin Password (Minimum 8 chars, uppercase, lowercase, number, special char)
VITE_ADMIN_PASSWORD=Siamali123@#

# Store Identification
VITE_STORE_NAME=BD Mart Bangladesh
VITE_STORE_HOTLINE=+880 1700-000000
VITE_STORE_SUPPORT_EMAIL=support@bdmart.com.bd
